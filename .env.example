APP_BASE_PATH = "/DLE_Games_Daily/"

DB_HOST = "localhost"
DB_NAME = ""
DB_USER = ""
DB_PASS = ""
DB_CHARSET = "utf8mb4"

# SMTP used for verification emails (e.g. a Mailtrap sandbox inbox)
MAIL_HOST = sandbox.smtp.mailtrap.io
MAIL_PORT = 2525
MAIL_USERNAME = your_smtp_username
